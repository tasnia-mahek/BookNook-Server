# HTTP port for the Express API.
PORT=5000
# MongoDB connection string.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/booknook
# MongoDB database name.
MONGODB_DB=booknook
# Better Auth JWT issuer.
BETTER_AUTH_ISSUER=http://localhost:3000
# Better Auth JWT audience.
BETTER_AUTH_AUDIENCE=booknook-server
# Better Auth JWKS endpoint.
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
# Comma-separated production and local client origins.
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001
